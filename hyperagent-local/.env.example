# LLM Provider Configuration
LLM_BASE_URL=https://ghostcli.cloud/v1
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5

# Authentication
# REQUIRED: Generate a cryptographically secure random secret before starting.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SESSION_MAX_AGE_DAYS=30

# Data Residency
DATA_DIR=./data
RESIDENCY_STRICT=false

# Server
PORT=3000
HOST=127.0.0.1
# Leave COOKIE_DOMAIN unset for host-only cookies (works on 127.0.0.1 and localhost).
# COOKIE_DOMAIN=
# COOKIE_SECURE defaults off on loopback HTTP; set true behind TLS.
# COOKIE_SECURE=true
